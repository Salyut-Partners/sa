{
  "name": "creative-factory-search",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Batch video-creative editor: photos + button/template layers + voice-over -> mp4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,editor -c blue,magenta \"npm:dev:server\" \"npm:dev:editor\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:editor": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "esbuild": "^0.25.0",
    "express": "^5.2.1",
    "puppeteer": "^25.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
